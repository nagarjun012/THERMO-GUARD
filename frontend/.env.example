# THERMOSAFE — Vercel Serverless Environment Variables
# Copy this file to .env.local and fill in your values for local development.
# In production, add these in your Vercel project → Settings → Environment Variables

# ------- SUPABASE (Required) -------
# Your Supabase project URL (Settings → API → Project URL)
SUPABASE_URL=https://your-project-id.supabase.co

# Your Supabase service_role key (Settings → API → service_role secret key)
# ⚠️  NEVER expose this in frontend code — only used in serverless functions
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ------- CRON SECURITY (Required) -------
# A random secret to protect the /api/refresh endpoint from unauthorized triggers
# Generate one: openssl rand -hex 32
CRON_SECRET=your-random-secret-here

# ------- VITE FRONTEND (Optional) -------
# API base URL — leave empty for same-origin (Vercel) or set for local dev
VITE_API_URL=
